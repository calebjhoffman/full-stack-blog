# server/.env.example

DATABASE_URL=postgresql://postgres:replace_me@db:5432/mini_blog

JWT_ACCESS_SECRET=replace_with_secure_random_value
JWT_REFRESH_SECRET=replace_with_secure_random_value
SESSION_SECRET=replace_with_secure_random_value

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

EMAIL_USER=your_email@example.com
EMAIL_PASS=your_google_app_password

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

OPENAI_API_KEY=your_openai_api_key
